<Window x:Class="PaxScan.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PaxScan.Desktop.ViewModels"
        Title="PaxScan Hub" Width="1100" Height="700" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding HubStatus}" Style="{StaticResource Muted}" />
        </Border>

        <TabControl Margin="8">
            <!-- Devices -->
            <TabItem Header="Devices" DataContext="{Binding Devices}">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Connected devices" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Pair new device" Command="{Binding PairNewDeviceCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Request sync on all" Command="{Binding RequestSyncAllCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Devices}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceRowVm}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,0,6,0" Fill="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding State}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="80" />
                            <DataGridTextColumn Header="App" Binding="{Binding AppVersion}" Width="60" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="100" />
                            <DataGridTextColumn Header="Last sync" Binding="{Binding LastSync}" Width="100" />
                            <DataGridTextColumn Header="Unsynced" Binding="{Binding PendingCount}" Width="75" />
                            <DataGridTextColumn Header="Last seq" Binding="{Binding LastSeq}" Width="70" />
                            <DataGridTemplateColumn Header="Flags" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceRowVm}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="Gap" Text="⚠ seq gap " Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"
                                                       ToolTip="Some updates from this device are missing (device_seq gap)." />
                                            <TextBlock x:Name="Req" Text="sync requested" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding SeqGapDetected}" Value="True">
                                                <Setter TargetName="Gap" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncRequested}" Value="True">
                                                <Setter TargetName="Req" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DeviceRowVm}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Request sync" Padding="6,1" MinWidth="0"
                                                    Command="{Binding DataContext.RequestSyncCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Revoke" Padding="6,1" MinWidth="0" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tasks -->
            <TabItem Header="Tasks" DataContext="{Binding Tasks}">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Tasks" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Sync with Online" Command="{Binding SyncWithWebCommand}" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Text="{Binding SyncMessage}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Tasks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Hub ver." Binding="{Binding Version}" Width="70" />
                            <DataGridTextColumn Header="Online ver." Binding="{Binding WebVersion}" Width="80" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Updates -->
            <TabItem Header="Updates log" DataContext="{Binding Updates}">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Status updates from devices" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            <CheckBox Content="Conflicts only" IsChecked="{Binding ConflictsOnly}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Updates}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                        <Setter Property="Background" Value="#FFF8C5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                        <Setter Property="Background" Value="#FFEBE9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Received (hub)" Binding="{Binding ReceivedAt}" Width="130" />
                            <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="2*" />
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="170" />
                            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="80" />
                            <DataGridTextColumn Header="Seq" Binding="{Binding DeviceSeq}" Width="50" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80" />
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="80" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Online" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Online API URL" />
                        <TextBox Text="{Binding WebBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                        <TextBlock Text="Hub token (from Online; leave empty to keep the stored one)" />
                        <PasswordBox x:Name="HubTokenBox" Margin="0,2,0,2" PasswordChanged="HubTokenBox_PasswordChanged" />
                        <TextBlock Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Text" Value="No token stored yet." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHubToken}" Value="True">
                                            <Setter Property="Text" Value="A token is stored (encrypted for this Windows user)." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="Hub network" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Address phones connect to (put in the pairing QR)" />
                        <ComboBox ItemsSource="{Binding LanAddresses}" Text="{Binding AdvertisedHost}" IsEditable="True" Margin="0,2,0,8" />
                        <TextBlock Text="Port" />
                        <TextBox Text="{Binding Port}" Width="100" HorizontalAlignment="Left" Margin="0,2,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="Windows Firewall" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                                   Text="Phones cannot connect until the hub port is allowed through the firewall. Run this once in an Administrator terminal:" />
                        <TextBox Text="{Binding FirewallCommand, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,4,0,4" TextWrapping="Wrap" />
                        <Button Content="Copy command" Command="{Binding CopyFirewallCommandCommand}" HorizontalAlignment="Left" />

                        <TextBlock Text="Identity" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                        <TextBlock Text="Hub ID" />
                        <TextBox Text="{Binding HubId, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,2,0,8" />
                        <TextBlock Text="Certificate SHA-256 (pinned by phones)" />
                        <TextBox Text="{Binding CertificateFingerprint, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,2,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
