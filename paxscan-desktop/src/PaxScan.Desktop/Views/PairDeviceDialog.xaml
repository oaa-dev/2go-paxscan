<Window x:Class="PaxScan.Desktop.Views.PairDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair a new device" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" Width="380">
        <TextBlock Text="Scan with the PaxScan app" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
        <Border BorderBrush="#D0D7DE" BorderThickness="1" Padding="8" HorizontalAlignment="Center">
            <Grid>
                <Image Source="{Binding QrImage}" Width="300" Height="300" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Border Background="#E6FFFFFF">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Expired" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
        <TextBlock Text="{Binding Countdown}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock Text="{Binding HubUrl}" HorizontalAlignment="Center" FontFamily="Consolas" Style="{StaticResource Muted}" />
        <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="New code" Command="{Binding NewCodeCommand}" />
            <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" IsCancel="True" Margin="0" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource Muted}" FontSize="11"
                   Text="The code works once and expires after 5 minutes. This window closes when the device has paired." />
    </StackPanel>
</Window>
